              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "indicators",
                "{{indicateur_id}}"
              ]
            },
            "description": "204 sans contenu.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"code\": \"IND-CHOM\",\n  \"nom\": \"Taux de chômage\",\n  \"description\": \"Part de la population active sans emploi\",\n  \"unite\": \"%\",\n  \"typeCollecte\": \"Enquête\",\n  \"frequence\": \"Annuelle\",\n  \"valeurCible\": 10,\n  \"anneeReference\": 2025,\n  \"categorieId\": 1\n}",
              "options": {
