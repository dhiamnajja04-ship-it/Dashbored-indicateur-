    {
      "name": "4. Regle centrale (IA)",
      "item": [
        {
          "name": "Perimetre exact de l'IA",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/indicators/validated",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "indicators",
                "validated"
              ]
            },
            "description": "LE point a verifier : uniquement les valeurs is_valid = true, et seulement les indicateurs qui en ont au moins une. C'est exactement ce que le service IA recoit."
          }
        },
        {
          "name": "Prompt envoye au modele",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/ia/contexte",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "ia",
                "contexte"
              ]
            },
            "description": "Renvoie le prompt exact SANS appeler le modele. Permet de controler le perimetre instantanement. Validez une valeur puis rappelez cette route : le prompt change."
          }
        },
        {
          "name": "Lancer une analyse",
          "request": {
            "method": "POST",
            "header": [
