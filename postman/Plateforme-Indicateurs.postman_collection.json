                "api",
                "indicators"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "taille",
                  "value": "10"
                },
                {
                  "key": "recherche",
                  "value": "densite"
                }
              ]
            },
            "description": "Recherche insensible a la casse ET aux accents (extension unaccent) : 'densite' trouve 'Densite medicale'."
