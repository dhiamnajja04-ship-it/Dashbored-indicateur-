              ],
              "path": [
                "api",
                "ia",
                "analyse"
              ]
            },
            "description": "question vide = synthese generale. indicateurId limite l'analyse a un indicateur. La reponse contient indicateursUtilises : les codes reellement transmis au modele.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"\",\n  \"indicateurId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
